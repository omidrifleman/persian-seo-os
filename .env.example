# --- Core ---
APP_ENV=dev
DATABASE_URL=postgresql://seo:seo@localhost:5432/seo_os
REDIS_URL=redis://localhost:6379/0

# --- LLM Gateway (هیچ‌وقت کلید واقعی را کامیت نکن) ---
LLM_PRIMARY=gemini
LLM_FALLBACKS=openai,anthropic,qwen
LLM_MONTHLY_BUDGET_USD=200
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
QWEN_API_KEY=

# --- SEO data ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GA4_PROPERTY_ID=

# --- DadmaTools / ezafe ---
# Absolute path to prefetched models + readiness marker (.persian_seo_os_dadma_pipeline_ok.v2)
PERSIAN_SEO_DADMA_CACHE=
# Production MUST be 1: refuse Pipeline() without readiness marker (no cold download).
# Dev/bootstrap may leave unset to allow one-time cold load that writes the marker.
PERSIAN_SEO_DADMA_REQUIRE_CACHE=1
WORDPRESS_BASE_URL=
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=
PUBLISH_DRY_RUN=true
PUBLISH_MAX_POSTS_PER_DOMAIN_PER_DAY=3
