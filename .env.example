LLM_FALLBACKS=openai,anthropic,qwen
LLM_MONTHLY_BUDGET_USD=200
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
QWEN_API_KEY=

# --- SEO data ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GA4_PROPERTY_ID=

# --- Publishing ---
WORDPRESS_BASE_URL=
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=
PUBLISH_DRY_RUN=true
PUBLISH_MAX_POSTS_PER_DOMAIN_PER_DAY=3
