# --- Core ---
APP_ENV=dev
DATABASE_URL=postgresql://seo:seo@localhost:5432/seo_os
REDIS_URL=redis://localhost:6379/0

# --- LLM Gateway (هیچ‌وقت کلید واقعی را کامیت نکن) ---
